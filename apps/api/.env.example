# =============================================================================
# TravelWise API — Environment Configuration
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
#
# Option 1 (Recommended for production): Set DATABASE_URL directly.
# This overrides all SQLSERVER_* variables below and is database-agnostic.
# Uncomment and fill in the appropriate URL for your database:
#
#   SQL Server (current):
#   DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+17+for+SQL+Server%7D%3BSERVER%3Dlocalhost%2C1433%3BDATABASE%3DTravelWiseDB%3BUID%3Dsa%3BPWD%3DYourPass%3BTrustServerCertificate%3Dyes%3B
#
#   PostgreSQL (future migration):
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/travelwise_db
#
#   SQLite (local development / tests only):
#   DATABASE_URL=sqlite:///./travelwise.db
#
# Option 2: Use individual SQL Server connection parameters (SQL Server only).
# Used as fallback when DATABASE_URL is not set.

SQLSERVER_SERVER=localhost
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrongPassword123!
SQLSERVER_DB=TravelWiseDB
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
SQLSERVER_TRUST_CERT=yes

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# LLM CONFIGURATION (supports "gemini" and "openai")
# =============================================================================
LLM_PROVIDER=gemini

# Google Gemini (Free tier, recommended): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI (Alternative):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# =============================================================================
# BLAZE AI - SPEECH TO TEXT (REALTIME)
# =============================================================================
BLAZE_API_KEY=your-blaze-api-key-here
BLAZE_STT_WS_URL=wss://api.blaze.vn/v1/stt/realtime
BLAZE_STT_MODEL=stt-stream-1.5
BLAZE_STT_SAMPLE_RATE=16000
BLAZE_STT_LANGUAGE=vi

# =============================================================================
# RAG & CHROMA CONFIGURATION
# =============================================================================
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=travelwise_knowledge
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=3

# App Configuration
PROJECT_NAME="TravelWise API"
API_V1_STR="/api/v1"

# SQL Server Database Configuration
SQLSERVER_SERVER=localhost
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrongPassword123!
SQLSERVER_DB=travelwise_db
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
SQLSERVER_TRUST_CERT=yes

# Optional: Override full database connection string directly if needed
# DATABASE_URL=mssql+pyodbc://sa:YourStrongPassword123!@localhost:1433/travelwise_db?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

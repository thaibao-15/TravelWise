# =============================================================================
# TravelWise LiveKit Voice Agent — Environment Configuration
# =============================================================================

# LiveKit Cloud or Self-Hosted WebSocket URL
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit Server API Credentials
LIVEKIT_API_KEY=your-livekit-api-key-here
LIVEKIT_API_SECRET=your-livekit-api-secret-here

# Agent Registration Name (Must match LIVEKIT_AGENT_NAME in apps/api/.env)
LIVEKIT_AGENT_NAME=travelwise-voice-assistant

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# Blaze AI — Speech To Text (STT) Realtime Configuration
# =============================================================================
BLAZE_API_KEY=your-blaze-api-key-here
BLAZE_STT_WS_URL=wss://api.blaze.vn/v1/stt/realtime
BLAZE_STT_MODEL=stt-stream-1.5
BLAZE_STT_LANGUAGE=vi
BLAZE_STT_SAMPLE_RATE=16000

# =============================================================================
# Blaze AI — Text To Speech (TTS) Realtime Configuration
# =============================================================================
BLAZE_TTS_WS_URL=wss://api.blaze.vn/v1/tts/realtime
BLAZE_TTS_SPEAKER_ID=DaNang-Nu-1-BL
BLAZE_TTS_MODEL=2.0-realtime
BLAZE_TTS_SPEED=1.5
BLAZE_TTS_AUDIO_QUALITY=64
BLAZE_TTS_AUDIO_FORMAT=mp3
BLAZE_TTS_NORMALIZATION=basic

# =============================================================================
# Backend FastAPI RAG & Internal Security Configuration
# =============================================================================
BACKEND_API_URL=http://127.0.0.1:8000
JWT_SECRET=your-secret-key-must-match-api-jwt-secret
JWT_ALGORITHM=HS256
